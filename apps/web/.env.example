# Frontend env. Only NEXT_PUBLIC_* values are exposed to the browser —
# never put API keys, secrets, or tokens in this file.

# Where the FastAPI backend lives.
NEXT_PUBLIC_API_URL=http://localhost:8000

# "mock" forces the frontend to use bundled fixtures and bypass the API.
# Anything else (including unset) means real API calls.
NEXT_PUBLIC_DATA_SOURCE=
