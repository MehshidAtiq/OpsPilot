APP_ENV=development
DATABASE_URL=postgresql+asyncpg://opspilot:opspilot@localhost:55432/opspilot
SYNC_DATABASE_URL=postgresql://opspilot:opspilot@localhost:55432/opspilot
AUTH_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000

# --- Storage ---
USE_MINIO=false
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=opspilot
MINIO_SECRET_KEY=opspilot-secret
MINIO_BUCKET=opspilot-documents

# --- LLM (Phase 3) ---
# Provider: "mock" | "openrouter". Falls back to mock if the API key is unset.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-coder:free
# Optional — OpenRouter analytics / per-app rate-limit tier.
OPENROUTER_REFERER=
OPENROUTER_APP_TITLE=OpsPilot

# --- Embeddings (Phase 3) ---
# Kept separate on purpose — embedding model swaps invalidate the index.
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
OPENAI_API_KEY=
